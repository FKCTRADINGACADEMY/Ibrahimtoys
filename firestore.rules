rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sirf logged-in admin hi products read/write kar sake.
    // Is app mein koi public signup nahi hai, isliye "signed in"
    // hona hi admin hone ke barabar hai.
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }
  }
}
